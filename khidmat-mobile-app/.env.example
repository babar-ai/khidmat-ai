# ─────────────────────────────────────────────────────────────────────────────
# Khidmat Mobile App — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables prefixed with EXPO_PUBLIC_ are safe to expose to the client.

# Base URL of the Khidmat FastAPI backend.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Platform             │ URL to use                                        │
# │──────────────────────│───────────────────────────────────────────────────│
# │ Android Emulator     │ http://10.0.2.2:8000  (routes to localhost:8000)  │
# │ Physical Android     │ http://<your-PC-IP>:8000  (e.g. 192.168.1.5:8000)│
# │ iOS Simulator        │ http://localhost:8000                             │
# │ Expo Go (any)        │ http://<your-PC-IP>:8000                          │
# └──────────────────────────────────────────────────────────────────────────┘
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
