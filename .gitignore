# ── Secrets & Keys (NEVER commit these) ──────────────────────────────────────
.env
*.env
.env.local
.env.*.local
!.env.example          # allow the example file through
*-adminsdk-*.json      # Firebase service account keys
firebase-credentials.json

# ── Mobile App (Expo / React Native) ────────────────────────────────────────
# Tracked in this monorepo — only ignore build artifacts and deps
khidmat-mobile-app/node_modules/
khidmat-mobile-app/.expo/
khidmat-mobile-app/dist/
khidmat-mobile-app/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
.eggs/
.venv/
venv/
env/
pip-log.txt

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations folder but ignore compiled cache
alembic/versions/__pycache__/
backend/alembic/versions/__pycache__/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it's needed to run the project

# ── Node / npm logs ─────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json   # allow recommended extensions list
.idea/
*.swp
*.swo

# ── AI / Agent tool configs (local only) ────────────────────────────────────
.claude/
.agents/
.gemini/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ──────────────────────────────────────────────────────────────────────
*.docx
*.zip
*.tar.gz
dist/